# ── LLM ──
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_KEY=your-llm-api-key-here
LLM_BASE_URL=

# ── Embedding ──
EMBED_PROVIDER=openai
EMBED_MODEL=text-embedding-3-small
EMBED_API_KEY=
EMBED_BASE_URL=

# ── ChromaDB ──
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ── Ingestion ──
CHUNK_SIZE=512
CHUNK_OVERLAP=50
